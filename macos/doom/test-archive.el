;;; test-archive.el -*- lexical-binding: t; -*-
;; Run: emacs --batch -Q -l macos/doom/test-archive.el

(require 'cl-lib)
(require 'org-archive)
(require 'org-id)
(defvar org-roam-file-exclude-regexp '("existing-exclusion"))
(defmacro after! (_feature &rest body) `(progn ,@body))
(defmacro map! (&rest _bindings) nil)
(defmacro use-package! (&rest _args) nil)
(load (expand-file-name ".config/doom/config.el"
                        (file-name-directory load-file-name)) nil t)

(let* ((directory (make-temp-file "doom-archive-test-" t))
       (project (expand-file-name "01-projects/example/example.org" directory))
       (archive (expand-file-name "04-archive/example/example-archive.org" directory))
       (fallback (expand-file-name "other.org" directory))
       (org-id-locations-file (expand-file-name "ids" directory))
       (org-id-locations (make-hash-table :test #'equal))
       (org-id-files nil))
  (unwind-protect
      (progn
        (make-directory (file-name-directory project) t)
        (make-directory (file-name-directory archive) t)
        (with-temp-file project
          (insert ":PROPERTIES:\n:ID: project-id\n:END:\n#+title: Example\n"
                  "#+ARCHIVE: ../../04-archive/example/example-archive.org::\n"
                  "* Tasks\n** Kernel PCA\n:PROPERTIES:\n:ID: parent-id\n:END:\n"
                  "Active parent body.\n*** DONE Finished work\n"
                  "CLOSED: [2026-10-08 Thu] SCHEDULED: <2026-10-07 Wed>\n"
                  ":PROPERTIES:\n:ID: task-id\n:END:\n"
                  "Notes to preserve.\n**** Details\n- [X] Preserve checklist\n"
                  "*** TODO Keep active\n*** DONE Second task\n"
                  "* Research Log\n** Kernel PCA\n*** DONE Separate branch\n"
                  "* Models / Baselines\n** Kernel PCA\n*** DONE Slash heading\n"))
        (cl-assert (not (file-exists-p archive)))
        (with-current-buffer (find-file-noselect project)
          (goto-char (point-min))
          (search-forward "DONE Finished work")
          (org-archive-subtree)
          (save-buffer)
          (cl-assert (not (string-match-p "Finished work" (buffer-string))))
          (cl-assert (string-match-p "TODO Keep active" (buffer-string)))
          (goto-char (point-min))
          (cl-assert (equal (org-entry-get nil "ID") "project-id")))
        (cl-assert (file-exists-p archive))
        (with-current-buffer (find-file-noselect archive)
          (goto-char (point-min))
          (search-forward "DONE Finished work")
          (cl-assert (equal (org-get-outline-path) '("Tasks" "Kernel PCA")))
          (cl-assert (equal (org-entry-get nil "ID") "task-id"))
          (cl-assert (equal (org-entry-get nil "ARCHIVE_OLPATH") "Tasks/Kernel PCA"))
          (cl-assert (equal (file-truename (org-entry-get nil "ARCHIVE_FILE"))
                            (file-truename project)))
          (dolist (text '("SCHEDULED: <2026-10-07 Wed>" "Notes to preserve."
                          "**** Details" "- [X] Preserve checklist"))
            (cl-assert (string-match-p (regexp-quote text) (buffer-string))))
          (cl-assert (not (string-match-p "parent-id\\|Active parent body" (buffer-string))))
          (goto-char (point-max))
          (insert "\n* Legacy archived item\n")
          (save-buffer))
        (dolist (name '("Second task" "Separate branch" "Slash heading"))
          (with-current-buffer (find-file-noselect project)
            (goto-char (point-min))
            (search-forward (concat "DONE " name))
            (org-archive-subtree)
            (save-buffer)))
        (with-current-buffer (find-file-noselect archive)
          (dolist (case '(("Second task" "Tasks" "Kernel PCA")
                          ("Separate branch" "Research Log" "Kernel PCA")
                          ("Slash heading" "Models / Baselines" "Kernel PCA")
                          ("Legacy archived item")))
            (goto-char (point-min))
            (search-forward (car case))
            (cl-assert (equal (org-get-outline-path) (cdr case))))
          (cl-assert (= 1 (how-many "^\\* Tasks$" (point-min) (point-max))))
          (cl-assert (= 3 (how-many "^\\*\\* Kernel PCA$" (point-min) (point-max)))))
        (with-current-buffer (find-file-noselect project)
          (goto-char (org-find-olp '("Tasks" "Kernel PCA") t))
          (org-end-of-subtree t t)
          (insert "*** DONE Latest reversed\n")
          (forward-line -1)
          (let ((org-archive-reversed-order t)) (org-archive-subtree))
          (save-buffer))
        (with-current-buffer (find-file-noselect archive)
          (cl-assert (< (string-match "Latest reversed" (buffer-string))
                        (string-match "Finished work" (buffer-string)))))
        (cl-assert (member "existing-exclusion" org-roam-file-exclude-regexp))
        (let ((regexp (car org-roam-file-exclude-regexp)))
          (cl-assert (string-match-p regexp archive))
          (cl-assert (not (string-match-p regexp
                                        (expand-file-name "04-archive/example/example.org" directory)))))
        (with-temp-file fallback (insert "* DONE Other work\n"))
        (with-current-buffer (find-file-noselect fallback)
          (goto-char (point-min))
          (org-archive-subtree)
          (save-buffer))
        (cl-assert (file-exists-p (concat fallback "_archive")))
        (with-temp-file (expand-file-name "rooted.org" directory)
          (insert "#+ARCHIVE: rooted.org_archive::* History\n* Parent\n** DONE Rooted task\n"))
        (with-current-buffer (find-file-noselect (expand-file-name "rooted.org" directory))
          (goto-char (point-min))
          (search-forward "DONE Rooted task")
          (org-archive-subtree)
          (save-buffer))
        (with-current-buffer (find-file-noselect (expand-file-name "rooted.org_archive" directory))
          (goto-char (point-min))
          (search-forward "DONE Rooted task")
          (cl-assert (equal (org-get-outline-path) '("History" "Parent"))))
        (with-current-buffer (find-file-noselect project)
          (goto-char (point-max))
          (insert "\n* Bulk\n** Shared\n*** DONE Bulk first\n*** DONE Bulk second\n")
          (goto-char (org-find-olp '("Bulk" "Shared") t))
          (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
            (org-archive-subtree '(4)))
          (save-buffer))
        (with-current-buffer (find-file-noselect archive)
          (dolist (name '("Bulk first" "Bulk second"))
            (goto-char (point-min))
            (search-forward name)
            (cl-assert (equal (org-get-outline-path) '("Bulk" "Shared")))))
        (with-current-buffer (find-file-noselect project)
          (goto-char (org-find-olp '("Tasks" "Kernel PCA") t))
          (org-end-of-subtree t t)
          (insert "*** DONE Keep on failure\n")
          (forward-line -1)
          (cl-letf (((symbol-function 'org-datetree-find-create-hierarchy)
                     (lambda (&rest _) (error "Simulated placement failure"))))
            (cl-assert (condition-case nil
                           (progn (org-archive-subtree) nil)
                         (error t))))
          (cl-assert (string-match-p "DONE Keep on failure" (buffer-string))))
        (princ "Archive check passed: hierarchy creation/reuse, distinct paths, subtree/context preservation, Roam exclusion, sibling fallback.\n"))
    (dolist (buffer (buffer-list))
      (when-let* ((file (buffer-file-name buffer)))
        (when (file-in-directory-p file directory)
          (with-current-buffer buffer
            (set-buffer-modified-p nil)
            (kill-buffer buffer)))))
    (delete-directory directory t)))
