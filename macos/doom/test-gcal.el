;;; test-gcal.el -*- lexical-binding: t; -*-
;; Run: emacs --batch -Q -l macos/doom/test-gcal.el

(require 'cl-lib)
(require 'org-agenda)
(defvar org-roam-file-exclude-regexp nil)
(defvar +org-gcal-private-directory)
(defvar org-gcal--sync-lock nil)
(defmacro after! (_feature &rest body) `(progn ,@body))
(defmacro map! (&rest _bindings) nil)
;; Exercise package setup without installing packages or making network requests.
(defmacro use-package! (_package &rest args) (plist-get args :init))

(let* ((directory (make-temp-file "doom-gcal-test-" t))
       (+org-gcal-private-directory directory)
       (client-file (expand-file-name "client.json" directory))
       (enabled-file (expand-file-name "auto-sync-enabled" directory))
       (calls nil))
  (unwind-protect
      (progn
        (with-temp-file client-file
          (insert "{\"installed\":{\"client_id\":\"test-id\",\"client_secret\":\"test-secret\"}}"))
        (load (expand-file-name ".config/doom/config.el"
                                (file-name-directory load-file-name)) nil t)
        (cl-assert (equal org-gcal-client-id "test-id"))
        (cl-assert (equal org-gcal-client-secret "test-secret"))
        (cl-assert (equal oauth2-auto-plstore (expand-file-name "oauth2.plist" directory)))
        (cl-assert (eq epg-pinentry-mode 'loopback))
        (cl-assert plstore-cache-passphrase-for-symmetric-encryption)
        (cl-assert (not org-gcal-auto-archive))
        (cl-assert (not org-gcal-remove-api-cancelled-events))
        (cl-assert (not org-gcal-remove-events-with-cancelled-todo))
        (cl-assert (equal org-gcal-cancelled-todo-keyword "CANCELED"))
        (cl-assert (equal org-gcal-managed-newly-fetched-mode "org"))
        (cl-assert (equal org-gcal-managed-update-existing-mode "org"))
        (cl-assert (eq org-gcal-recurring-events-mode 'nested))
        (cl-assert (equal (mapcar (lambda (calendar) (file-name-nondirectory (cdr calendar)))
                                 org-gcal-fetch-file-alist)
                          '("main.org" "school.org" "work.org")))
        (cl-assert (cl-every (lambda (calendar) (member (cdr calendar) org-agenda-files))
                             org-gcal-fetch-file-alist))
        (cl-assert (not +org-gcal-sync-timer))
        (dolist (invalid '("{\"web\":{\"client_id\":\"id\",\"client_secret\":\"secret\"}}"
                           "{\"installed\":{\"client_id\":\"\",\"client_secret\":\"secret\"}}"
                           "{\"installed\":{\"client_id\":\"id\"}}"))
          (with-temp-file client-file (insert invalid))
          (cl-assert (condition-case nil
                         (progn (+org-gcal-load-credentials) nil)
                       (user-error t))))
        (let ((original-require (symbol-function 'require)))
          (cl-letf (((symbol-function 'require)
                     (lambda (feature &rest args)
                       (if (eq feature 'org-gcal) t
                         (apply original-require feature args))))
                    ((symbol-function 'org-gcal-sync)
                     (lambda (&rest args) (push args calls)))
                    ((symbol-function 'active-minibuffer-window) (lambda () nil)))
            (cl-assert (condition-case nil
                           (progn (+org-gcal-auto-sync-mode 1) nil)
                         (user-error t)))
            (cl-assert (not +org-gcal-auto-sync-mode))
            (cl-assert (not (file-exists-p enabled-file)))
            (with-temp-file oauth2-auto-plstore (insert "fake token store for offline test"))
            (+org-gcal-auto-sync-mode 1)
            (cl-assert (timerp +org-gcal-sync-timer))
            (cl-assert (= (timer--repeat-delay +org-gcal-sync-timer) 600))
            (cl-assert (file-exists-p enabled-file))
            (let ((old-timer +org-gcal-sync-timer))
              (+org-gcal-auto-sync-mode 1)
              (cl-assert (not (memq old-timer timer-list))))
            (+org-gcal-background-sync)
            (cl-assert (equal calls '((nil t))))
            (let ((org-gcal--sync-lock t)) (+org-gcal-background-sync))
            (cl-letf (((symbol-function 'active-minibuffer-window) (lambda () t)))
              (+org-gcal-background-sync))
            (cl-assert (= (length calls) 1))
            (cl-letf (((symbol-function 'org-gcal-sync) (lambda (&rest _) (error "offline"))))
              (+org-gcal-background-sync))
            (let ((old-timer +org-gcal-sync-timer))
              (+org-gcal-auto-sync-mode -1)
              (cl-assert (not (memq old-timer timer-list))))
            (cl-assert (not +org-gcal-sync-timer))
            (cl-assert (not (file-exists-p enabled-file)))))
        (princ "Calendar check passed: private credentials, three agenda files, safe defaults, opt-in timer, reload/disable and sync guards.\n"))
    (when (timerp +org-gcal-sync-timer) (cancel-timer +org-gcal-sync-timer))
    (delete-directory directory t)))
